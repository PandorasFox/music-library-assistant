// Music Magic (MM) Configuration
// Save this as $XDG_CONFIG_HOME/mm/config.kdl (or ~/.config/mm/config.kdl if XDG_CONFIG_HOME is not set)

// Storage root — this IS the corpus directory (no corpus/ subdirectory)
storage-root "/Volumes/cerberus/archive/audio"

// Optional: override where libraries and stash live (default: under storage-root)
// libraries-root "/Volumes/cerberus/libraries"
// stash-root "/Volumes/cerberus/stash"

// Define source directories within the corpus and their library deployment targets.
// Paths are relative to the storage-root.
// A single source can deploy to multiple libraries.
dir "web/releases/bandcamp" {
    library "music"
}

dir "web/releases/steam" {
    library "soundtracks"
}

dir "physical/vinyls" {
    library "music"
    // can-stash-dupes false
}

// ============================================================================
// Opinions - Configure MM's default behaviors
// ============================================================================
// All opinions have sensible defaults. Uncomment and modify as needed.

opinions {
    // -------------------------------------------------------------------------
    // Lossy Format Handling
    // -------------------------------------------------------------------------
    // When true, lossy formats (MP3, M4A, etc.) are captured to FLAC instead of
    // transcoded to Opus. The decoded PCM waveform is losslessly stored in a
    // FLAC container with extension e.g. `.mp3.LOSSY.flac`. (default: false)
    // lossy-shit-formats-to-flac false

    // -------------------------------------------------------------------------
    // Startup Behavior
    // -------------------------------------------------------------------------
    startup {
        // Force verification of all indexed files at startup (default: false)
        // Bypasses mtime optimization - verifies all files regardless of modification time.
        // Catches out-of-band tag changes (external tools modified tags) and corrupt files.
        // Slower startup but ensures database matches reality.
        // force-check-all-files false

        // Free-page ratio threshold for prompting DB compaction (default: 0.1 = 10%).
        // When free pages exceed this fraction of total pages, MM will prompt to VACUUM.
        // Set to 0.0 to disable the prompt entirely.
        // vacuum-threshold 0.1
    }

    // -------------------------------------------------------------------------
    // Canonicalization - Tag normalization rules
    // -------------------------------------------------------------------------
    canonicalization {
        // Strip EP/LP suffixes during album collision detection (default: false)
        // When true, "Album EP" and "Album" normalize to the same key and collide.
        // strip-album-format-suffixes false
    }

    // -------------------------------------------------------------------------
    // Health Detection - Required tags and health signals
    // -------------------------------------------------------------------------
    health-detection {
        // Tags that must be present on every track
        // (default: "title" "album" "artist" "album_artist")
        // required-tags "title" "album" "artist" "album_artist"
    }

    // -------------------------------------------------------------------------
    // Tag Splitting - Detect compound tag values
    // -------------------------------------------------------------------------
    // - collab: keywords for detecting featuring patterns (artist tags only)
    // - Other nodes: tag name with list of separator strings
    //
    // tag-splitting {
    //     collab "feat" "featuring" "ft" "with" "vs"
    //     artist ";"
    //     genre ";"
    // }

    // -------------------------------------------------------------------------
    // External Matching - MusicBrainz / AcoustID
    // -------------------------------------------------------------------------
    // external-matching {
    //     acoustid-api-key "your-key-here"
    //     mb-base-url "https://musicbrainz.org/ws/2"
    //
    //     // MusicBrainz tag names written to corpus files.
    //     // Defaults are clean entity names that map directly to MB concepts.
    //     mb-tag-names {
    //         recording "MUSICBRAINZ_RECORDING"
    //         release "MUSICBRAINZ_RELEASE"
    //         track "MUSICBRAINZ_TRACK"
    //
    //         // Also write Picard-style aliases (MUSICBRAINZ_ALBUMID, etc.)
    //         // alongside the clean names. Needed for Navidrome PID matching
    //         // and other Picard-aware software.
    //         picard-compat false
    //     }
    // }

    // -------------------------------------------------------------------------
    // Duplicate Analysis - Fingerprint-based duplicate detection
    // -------------------------------------------------------------------------
    duplicate-analysis {
        // Fingerprint similarity threshold 0-100 (default: 85.0)
        // Pairs below this are not considered duplicates
        // fingerprint-similarity-threshold 85.0

        // Duration tolerance in ms (default: 2000)
        // Tracks with duration difference above this are clustered separately
        // duration-tolerance-ms 2000
    }

    // -------------------------------------------------------------------------
    // Performance - Thread counts, caches, instrumentation
    // -------------------------------------------------------------------------
    performance {
        // Number of worker threads (default: 2x logical cores)
        // worker-threads 16

        // SQLite page cache size per connection (default: 256mb)
        // Accepts: plain number (MB), or suffixed "256mb", "1gb", "512kb"
        // db-cache "256mb"

        // Enable timing instrumentation and stats display (default: false)
        // When false, skips all atomic counter updates for better performance
        // timing-instrumentation false
    }
}
