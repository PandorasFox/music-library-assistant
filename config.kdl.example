// Music Library Assistant (MLA) Configuration
// Save this as $XDG_CONFIG_HOME/mla/config.kdl (or ~/.config/mla/config.kdl if XDG_CONFIG_HOME is not set)

// archive-root "/path/to/archive"

// Root directory of your music corpus
corpus-root "/archive/corpus"
stash-dir "/archive/working/stash"
// Optional: Path to your legacy library that needs organization
// useful if you are working at dissecting an existing tag-organized library into a better organization strategy :)
legacy-library "/archive/working/legacy"

// Define your libraries to deploy organized hard links under
library "music" {
    path "/archive/libraries/music"
}

library "soundtracks" {
    path "/archive/libraries/soundtracks"
}

// Deploy mappings - Define which corpus directories deploy to which libraries
// This is required for the Deploy feature to work
// Format: deploy "<relative-path-in-corpus>" { library "library-name" ... }

// Example 1: Deploy general music to the main library
deploy "web/releases/bandcamp" {
    library "music"
}

deploy "web/releases/steam" {
	library "soundtracks"
}

deploy "physical/vinyls" {
	library "music"
}

// ============================================================================
// Opinions - Configure MLA's default behaviors
// ============================================================================
// All opinions have sensible defaults. Uncomment and modify as needed.

opinions {
    // -------------------------------------------------------------------------
    // Startup Behavior
    // -------------------------------------------------------------------------
    startup {
        // Run health check on startup (default: true)
        // heartbeat-on-startup true

        // Verify in-file tags match database at startup (default: true)
        // This is "paranoid" mode - catches out-of-band tag edits by external tools
        // Disable if startup is too slow with large libraries
        // paranoid-tag-verification true

        // Show DB thread performance stats on splash screen (default: false)
        // Useful for debugging performance issues during startup
        // show-db-stats-on-splash false

        // Force content analysis once at startup, even without mutations (default: false)
        // Useful after fixing broken computations to re-derive signals.
        // One-shot latch: triggers once, then auto-clears.
        // freshen-last-stage false
    }

    // -------------------------------------------------------------------------
    // Fingerprint Matching - How to detect duplicate audio
    // -------------------------------------------------------------------------
    fingerprint-matching {
        // Duration difference above this % = different track (default: 10.0)
        // Higher values = more lenient matching
        // duration-tolerance-percent 10.0

        // Same directory + different track number = not duplicate (default: true)
        // Prevents marking "Track 01" and "Track 02" from same album as dupes
        // require-matching-track-number true

        // Require matching album to be considered duplicate (default: false)
        // Set to true if you want re-releases to be flagged separately
        // require-matching-album false
    }

    // -------------------------------------------------------------------------
    // Quality Resolution - Auto-resolve duplicate quality variants
    // -------------------------------------------------------------------------
    quality-resolution {
        // FLAC beats MP3 automatically (default: true)
        // When true, lossless formats auto-win over lossy
        // auto-resolve-format-tier true

        // Bitrate difference above this % = clear winner (default: 50.0)
        // e.g., 320kbps vs 128kbps = 150% diff, clear winner
        // bitrate-threshold-percent 50.0
    }

    // -------------------------------------------------------------------------
    // Canonicalization - Tag normalization rules
    // -------------------------------------------------------------------------
    canonicalization {
        // Case-insensitive matching (default: true)
        // "the beatles" and "The Beatles" are considered the same
        // case-insensitive true

        // Strip parentheticals like "(Live)" or "(Remastered)" (default: false)
        // strip-parentheticals false

        // Fuzzy matching threshold 0.0-1.0 (default: 0.85)
        // Higher = stricter matching, lower = more lenient
        // fuzzy-threshold 0.85
    }

    // -------------------------------------------------------------------------
    // Re-releases - Same audio appearing on different albums
    // -------------------------------------------------------------------------
    re-releases {
        // How to handle same fingerprint on different albums
        // Options: "mark-variant" (default), "ignore", "flag"
        //   mark-variant: Track as known variant, don't flag as duplicate
        //   ignore: Completely ignore, treat as separate tracks
        //   flag: Flag for manual review
        // same-fingerprint-different-album "mark-variant"
    }
}
